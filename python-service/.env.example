# Python Inference Service Configuration
# Copy to .env and adjust as needed

# Server
PORT=8100
HOST=0.0.0.0
ALLOWED_ORIGINS=*

# Device
DEVICE=cuda

# Model cache
MODEL_CACHE_DIR=/root/.cache/huggingface
HF_HOME=/root/.cache/huggingface
HUGGINGFACE_HUB_CACHE=/root/.cache/huggingface

# Model enable flags
ENABLE_ZIMAGE_TURBO=true
ENABLE_FLUX_KLEIN=true
ENABLE_ZIMAGE_BASE=true
ENABLE_QWEN_2512=false
ENABLE_MOSS_SFT=true

# Prompt parser
PROMPT_PARSER_MODEL=Qwen/Qwen3-VL-4B-Instruct
PROMPT_PARSER_FALLBACK=Qwen/Qwen2.5-0.5B-Instruct

# Quality evaluator
VLM_EVALUATOR_MODEL=Qwen/Qwen3-VL-4B-Instruct
FLORENCE2_MODEL=microsoft/Florence-2-base-ft

# Logging
LOG_LEVEL=INFO
