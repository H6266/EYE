# EYE — Local-First Configuration
# No external AI API credentials are required for local operation.
# All generation features use local engines (SDXS-512 ONNX CPU).

# Server
PORT=3000
NODE_ENV=development

# Local model cache
MODEL_CACHE_DIR=/workspaces/EYE/.cache

# Pre-warm local diffusion engine on startup
PREWARM_LOCAL_DIFFUSION=true

# AI Inference Gateway (local-only: mock is the only provider)
AI_INFERENCE_PROVIDER=mock
AI_PROVIDER_TIMEOUT_MS=600000

# Hugging Face (optional, for Florence-2 / SAM2 if hosted endpoints are used)
# HF_TOKEN=

# Hugging Face dedicated custom Inference Endpoints (optional)
# HF_GENERATION_ENDPOINT_URL=
# HF_FLORENCE_ENDPOINT_URL=
# HF_SAM2_ENDPOINT_URL=

# RunPod Serverless worker endpoint IDs (optional)
# RUNPOD_API_KEY=
# RUNPOD_GENERATION_ENDPOINT_ID=
# RUNPOD_FLORENCE_ENDPOINT_ID=
# RUNPOD_SAM2_ENDPOINT_ID=

# Optional S3-compatible generated-result storage (backend only, not required)
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=